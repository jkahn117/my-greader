{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-greader",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    // Built React client (vite build → dist/client). Requests that do not
    // match a file asset serve index.html so client-side routes deep-link.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // Dashboard JSON API and GReader routes stay on the Worker.
    "run_worker_first": [
      "/",
      "/app/api/*",
      "/reader/*",
      "/api/*",
      "/accounts/*",
      "/auth/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rss-reader",
      "database_id": "63efba50-bf5f-497c-8f1e-e0c4c341546d", // fill after: wrangler d1 create rss-reader
      "migrations_dir": "./drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *", // feed fetcher
      "0 3 * * 1" // weekly Item and polling-history cleanup (Mondays 03:00 UTC)
    ]
  },
  "vars": {
    // Days to retain articles before the cleanup cron removes them
    "ITEM_RETENTION_DAYS": "30",
    // Cloudflare account ID
    "CF_ACCOUNT_ID": "0fd0283d83ecc1b5c563c57c91893694",
    // IANA timezone for the metrics dashboard (e.g. "America/New_York"). Defaults to UTC if unset.
    "DISPLAY_TIMEZONE": "America/Chicago",
    // Set to "false" to disable all Analytics Engine metric writes and AE SQL dashboard queries.
    "ANALYTICS_ENABLED": "true"
  },
  "secrets": {
    "required": ["CF_ACCESS_AUD", "CF_ACCESS_ISSUER"]
  },
  // Secrets — set via: wrangler secret put <NAME>
  // CF_ACCESS_AUD  — Cloudflare Access audience tag (JWT verification)
  // CF_ACCESS_ISSUER — Exact HTTPS Access team origin, without a trailing slash
  // CF_API_TOKEN   — Cloudflare API token (Account Analytics:Read) for AE SQL dashboard queries
  // Metrics are written to Workers Analytics Engine (fire-and-forget, no R2 accumulation).
  // The dashboard queries D1 directly; AE data supplements with aggregate time-series.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "rss_reader_metrics"
    }
  ],
  "workflows": [
    {
      "name": "feed-polling",
      "binding": "FEED_POLLING_WORKFLOW",
      "class_name": "FeedPollingWorkflow"
    }
  ],
  "routes": [
    {
      "custom_domain": true,
      "zone_name": "iamjkahn.com",
      "pattern": "reader.iamjkahn.com"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      // Unique namespace within the Cloudflare account
      "namespace_id": "1001",
      // 5 login attempts per 60 seconds per IP
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "workers_dev": false
}
