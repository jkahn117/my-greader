{
  "name": "2026-04-04-my-greader",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/styles.css -o public/styles.css --minify",
    "dev:css": "tailwindcss -i src/styles.css -o public/styles.css --watch",
    "dev": "pnpm build:css && vite",
    "build": "pnpm build:css && vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "test": "vitest run",
    "test:browser": "playwright test",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "lint": "oxlint src test",
    "studio": "drizzle-kit studio --config drizzle.local.config.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "^1.170.41",
    "@workers-powertools/hono": "^0.4.0",
    "@workers-powertools/logger": "^0.2.0",
    "@workers-powertools/metrics": "^0.4.0",
    "@workers-powertools/tracer": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.0",
    "hono": "^4.13.2",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.14.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^12.11.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-ssr-components": "^0.5.2",
    "wrangler": "^4.123.0"
  }
