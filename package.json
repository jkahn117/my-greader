{
  "name": "2026-04-04-my-greader",
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "build:css": "tailwindcss -i src/styles.css -o public/styles.css --minify",
    "dev:css": "tailwindcss -i src/styles.css -o public/styles.css --watch",
    "dev": "pnpm build:css && vite",
    "build": "pnpm build:css && vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "test": "pnpm test:development && pnpm test:production-auth",
    "test:development": "vitest run --config vitest.config.ts",
    "test:production-auth": "vitest run --config vitest.production.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm build",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "format": "oxfmt --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "lint": "oxlint src test",
    "studio": "drizzle-kit studio --config drizzle.local.config.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@workers-powertools/hono": "^0.4.0",
    "@workers-powertools/logger": "^0.2.0",
    "@workers-powertools/metrics": "^0.4.0",
    "@workers-powertools/tracer": "^0.2.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.12",
    "linkedom": "^0.18.13",
    "rss-parser": "^3.13.0",
    "valibot": "^1.5.0",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-pool-workers": "^0.14.9",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.9",
    "better-sqlite3": "^12.11.1",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-ssr-components": "^0.5.2",
    "wrangler": "^4.147.0"
  }
}
